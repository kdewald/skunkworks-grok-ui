{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skunkworks Grok UI",
  "version": "0.8.0",
  "identifier": "dev.kdewald.skunkworks.grokui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Skunkworks Grok UI",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Unofficial desktop ACP client for Grok, Codex, and Claude.",
    "longDescription": "Skunkworks Grok UI is an independent, unofficial desktop client for Grok, Codex, and Claude coding agents. It provides a multi-project chat sidebar, collapsible agent work, attachments, and permission prompts over the Agent Client Protocol. Build from source; no official support.",
    "copyright": "Copyright 2026 kdewald. Licensed under Apache-2.0.",
    "publisher": "kdewald",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
